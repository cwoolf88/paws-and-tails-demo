# Load in Next: copy to ".env.local" (leading dot is required; "env.local" alone is not loaded)
#   cp env.example .env.local

# -----------------------------------------------------------------------------
# Local "stack" (sibling anemone-server-js + anemone on your machine)
# -----------------------------------------------------------------------------
# SDK (anemone-server-js)
#   - package.json already uses: "file:../anemone-server-js"
#   - re-pin the link anytime: npm run install:sdk:local
#   - custom path: LOCAL_ANEMONE_SERVER_JS=../other/anemone-server-js npm run install:sdk:local
#   - after editing SDK: npm run sdk:rebuild:local
#
# Primary (anemone)
#   - run its app (commonly one Next server on a port, e.g. 3000)
#   - run this demo on a different port: npm run dev:local   (defaults to 3001; use dev:local:webpack if you hit resolver issues)
#   - in .env.local set the base URL + key and clear mock, e.g.:
#         ANEMONE_USE_MOCK=0
#         ANEMONE_PRIMARY_BASE_URL=http://127.0.0.1:3000
#         ANEMONE_API_KEY=your-bearer-key-from-the-primary
#   - on the primary, set webhook target to this app, e.g.:
#         http://127.0.0.1:3001/api/webhooks/contact-changed
# -----------------------------------------------------------------------------

# Unset/empty the next two to stay in built-in mock mode, or set them to hit a real (or local) primary
# ANEMONE_PRIMARY_BASE_URL=
# ANEMONE_API_KEY=
# Optional: prefix embedded in locally signed connect tokens (defaults from API key shape or "demo")
# Must match api_key_prefix on primary (defaults to segment before first _ in API key, e.g. pnd)
# ANEMONE_API_KEY_PREFIX=pnd
# Full-page return URL (optional). Connect/disconnect URLs use /account/contact/bridge-return for popup flows.
# ANEMONE_CONNECT_RETURN_URL=http://127.0.0.1:3001/account/contact
# ANEMONE_DEMO_BASE_URL=http://127.0.0.1:3001
ANEMONE_UPDATE_PATH=/api/v1/contacts/update
ANEMONE_WEBHOOK_SECRET=replace-with-long-random-secret
# Set to 1 to force the mock even when a base URL and API key are set
# ANEMONE_USE_MOCK=1
# In mock only: set to 1 to randomize idempotency-keyed outcomes (incl. rejected). Default: always success
# ANEMONE_MOCK_ROTATE_OUTCOMES=1
# -----------------------------------------------------------------------------
# Deployed environments (Amplify branch env vars)
# -----------------------------------------------------------------------------
# APP_ENV=development|test|production
# NEXT_PUBLIC_APP_ENV=development|test|production
# Point ANEMONE_PRIMARY_BASE_URL at the matching Anemone Amplify URL.
# For production, set ANEMONE_USE_MOCK=0 and real API key + webhook secret.
# Hybrid mobile apps will keep using the same ANEMONE_* server config.
