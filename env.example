# Load in Next: copy to ".env.local" (leading dot is required; "env.local" alone is not loaded)
#   cp env.example .env.local

# -----------------------------------------------------------------------------
# Local "stack" (sibling next-address-server-js + next-address-primary on your machine)
# -----------------------------------------------------------------------------
# SDK (next-address-server-js)
#   - package.json already uses: "file:../next-address-server-js"
#   - re-pin the link anytime: npm run install:sdk:local
#   - custom path: LOCAL_NEXT_ADDRESS_SERVER_JS=../other/next-address-server-js npm run install:sdk:local
#   - after editing SDK: npm run sdk:rebuild:local
#
# Primary (next-address-primary)
#   - run its app (commonly one Next server on a port, e.g. 3000)
#   - run this demo on a different port: npm run dev:local   (defaults to 3001; use dev:local:webpack if you hit resolver issues)
#   - in .env.local set the base URL + key and clear mock, e.g.:
#         NEXT_ADDRESS_USE_MOCK=0
#         NEXT_ADDRESS_PRIMARY_BASE_URL=http://127.0.0.1:3000
#         NEXT_ADDRESS_API_KEY=your-bearer-key-from-the-primary
#   - on the primary, set webhook target to this app, e.g.:
#         http://127.0.0.1:3001/api/webhooks/contact-changed
# -----------------------------------------------------------------------------

# Unset/empty the next two to stay in built-in mock mode, or set them to hit a real (or local) primary
# NEXT_ADDRESS_PRIMARY_BASE_URL=
# NEXT_ADDRESS_API_KEY=
NEXT_ADDRESS_TENANT_ID=demo-tenant
# Return URL after connect/disconnect on next-address-primary (defaults to http://127.0.0.1:3001/account/contact)
# NEXT_ADDRESS_CONNECT_RETURN_URL=http://127.0.0.1:3001/account/contact
# NEXT_ADDRESS_DEMO_BASE_URL=http://127.0.0.1:3001
NEXT_ADDRESS_UPDATE_PATH=/api/v1/contacts/update
NEXT_ADDRESS_WEBHOOK_SECRET=replace-with-long-random-secret
# Set to 1 to force the mock even when a base URL and API key are set
# NEXT_ADDRESS_USE_MOCK=1
# In mock only: set to 1 to randomize idempotency-keyed outcomes (incl. rejected). Default: always success
# NEXT_ADDRESS_MOCK_ROTATE_OUTCOMES=1
